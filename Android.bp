soong_config_module_type {
    name: "wifihal_qcom_defaults",
    module_type: "cc_defaults",
    config_namespace: "qcom_wifi",
    properties: [
        "shared_libs",
        "whole_static_libs",
    ],
}

wifihal_qcom_defaults {
    name: "libwifi-hal-qcom",
    whole_static_libs: [
        "//hardware/qcom/wlan/qcwcn/wifi_hal:libwifi-hal-qcom",
    ],
    shared_libs: [
        "//hardware/qcom/wlan/cld80211-lib:libcld80211",
        "libcrypto",
    ],
}
